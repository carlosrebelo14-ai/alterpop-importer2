# =============================================================================
# Alterpop Importer — Shopify embedded app
# =============================================================================

# Prisma — caminho do SQLite. Em produção (Fly) deve apontar para o volume
# persistente montado (ex.: file:/app/data/dev.sqlite), nunca para um caminho
# efémero do container — senão a BD reinicia vazia a cada reboot/deploy.
DATABASE_URL=file:./dev.sqlite

# Dev Dashboard → Apps → alterpop-importer → API credentials
SHOPIFY_API_KEY=your_client_id_here
SHOPIFY_API_SECRET=your_client_secret_here
SHOPIFY_API_VERSION=2025-10

# Produção (fallback sem sessão OAuth persistida):
# - SHOPIFY_SHOP_URL: domínio myshopify.com (com ou sem https://)
# - SHOPIFY_ACCESS_TOKEN: Admin API access token da loja real
SHOPIFY_SHOP_URL=
SHOPIFY_ACCESS_TOKEN=

# Set by `shopify app dev` (do not hardcode — URL antiga causa loop OAuth)
# SHOPIFY_APP_URL=https://your-tunnel.example.com
# URL pública da app (OAuth, webhooks). Monitorização: ping externo GET /api/health (UptimeRobot, 5 min).
APP_URL=

# SQLite: espera até N ms quando a BD está locked (default 5000)
# SQLITE_BUSY_TIMEOUT_MS=5000

# Dev: file = JSON em data/sessions | prisma = SQLite (prisma/dev.sqlite)
SESSION_STORAGE=file
# SCOPES=read_products,write_products,read_inventory,write_inventory,read_locations,read_orders,read_customers,write_customers,read_publications,write_publications

# Optional: primary inventory location GID (auto-detected if empty)
# Aceita GID completo ou ID numérico (ex.: 123456789 → convertido para gid://shopify/Location/123456789)
SHOPIFY_LOCATION_ID=

# GraphQL rate limiting (leaky bucket)
SHOPIFY_GRAPHQL_CONCURRENCY=2
SHOPIFY_GRAPHQL_MIN_MS=250

# Stream importer: concurrent CSV rows processed (default 2)
STREAM_CONCURRENCY=2
PRODUCT_DELAY_MS=300

# OcioStock feed (semicolon-delimited CSV)
OCIOSTOCK_CSV_URL=https://ociostock.gesio.be/dyndata/exportaciones/csvzip/catalog_1_50_54_2_40836fd3ce5ea622a4d34a8aa6c8cda3_csv_plain.csv

# Google AI Studio → API Keys → GOOGLE_API_KEY (Gemini curadoria)
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Modelo (gemini-1.5-flash pode dar 404 — usar gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
# 0 = desactiva chamadas Gemini (produtos ficam PENDING na curadoria AI)
GEMINI_CURATION_ENABLED=1
# Pedidos/min (free tier ~5; usar 4 para margem)
GEMINI_RPM=4
# Limite por processo do servidor (0 = ilimitado; cache evita repetidos)
GEMINI_MAX_CALLS=0

# Sincronização Shopify — lotes de 20, pausa 1s entre lotes
BATCH_SIZE=20
BATCH_DELAY_MS=1000

# Translation ES → EN (glossary + DeepL)
TRANSLATION_PROVIDER=deepl
TRANSLATION_API_KEY=
TRANSLATION_SOURCE_LANG=ES
TRANSLATION_TARGET_LANG=EN

# Import safety — keep true until ready for live sync
DRY_RUN=true
IMPORT_MODE=CREATE_AND_UPDATE
BATCH_SIZE=50
BATCH_DELAY_MS=500
SYNC_PRODUCTS=true
SYNC_INVENTORY=true
SYNC_LIMIT=10
SKU_ALLOWLIST=
