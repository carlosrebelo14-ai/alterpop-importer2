// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

/// Fila persistente de importações OcioStock (background — UI faz polling).
model BackgroundImportJob {
  id              String    @id
  shop            String
  state           String    @default("queued")
  progressPercent Float     @default(0)
  processedRows   Int       @default(0)
  totalRows       Int       @default(0)
  currentSku      String?
  dryRun          Boolean   @default(true)
  payload         String
  error           String?
  resultsJobId    String
  createdAt       DateTime  @default(now())
  startedAt       DateTime?
  finishedAt      DateTime?

  @@index([shop, state])
  @@index([createdAt])
}

/// Catálogo OcioStock indexado por loja (paginação server-side no painel de curadoria).
model CatalogProduct {
  shop             String
  sku              String
  title            String
  categoryMain     String?
  categorySegments String   @default("[]")
  vendor           String?
  vendorNorm       String   @default("")
  stock            Int      @default(0)
  // Sinais de família do feed, separados (parseFamilySignals):
  //  - franchises: refs + tokens de categoria achatados (histórico, alimenta facetas/filtros)
  //  - franchiseRefs: SÓ os ref="..." do fornecedor, sem tradução (chave da camada 1 do resolver)
  franchises       String   @default("[]")
  franchiseRefs    String   @default("[]")
  // Universo resolvido pelo franchiseResolver (nome canónico da tabela dos 41), ou NULL.
  // resolvedFranchiseLayer: 1 = ref, 2 = título, para auditoria. NULL até à Fase 4.
  resolvedFranchise      String?
  resolvedFranchiseLayer Int?
  netPrice         Float?
  grossPrice       Float?
  imageUrl         String?
  barcode          String?
  weightKg         Float?
  // "supplier" = título já veio em inglês do fornecedor e NÃO deve ser re-traduzido
  // na leitura nem no publish; "pipeline" (ou null, em linhas anteriores a 2026-08-04)
  // = passou pelo glossário + API e mantém o comportamento antigo.
  titleSource      String?
  // Dimensões da embalagem já formatadas ("25 × 5 × 15 cm"), de xml_info_dimensiones.
  // NULL nos ~31% de produtos sem esse dado no feed — nesses não gera linha nem metafield.
  dimensions       String?
  // Pauta aduaneira (hs_intrastat_code), normalizada para 6 ou 8 dígitos.
  // NULL nos ~9,3% sem valor aproveitável — nesses o campo é omitido no publish.
  hsCode           String?
  indexedAt        DateTime @default(now())

  @@id([shop, sku])
  @@index([shop, vendorNorm])
  @@index([shop, categoryMain])
  @@index([shop, netPrice])
  @@index([shop, barcode])
  @@index([shop, resolvedFranchise])
}

/// Tags de filtro sitemap (OR na UI — produto pode ter várias tags).
model CatalogProductFilterTag {
  shop     String
  sku      String
  filterId String

  @@id([shop, sku, filterId])
  @@index([shop, filterId])
  @@index([shop, sku])
}

/// Registo agregado por corrida do relógio/sync em massa (item 16 do roadmap).
/// `id` é o mesmo jobId do ShopifySyncJobStatus (shopifySyncJob.server.js) —
/// SyncErrorLog.jobId liga-se a este id sem precisar de foreign key formal.
model SyncJob {
  id         String    @id
  shop       String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  received   Int       @default(0)
  succeeded  Int       @default(0)
  failed     Int       @default(0)
  /// "running" | "completed" | "failed"
  status     String    @default("running")

  @@index([shop, startedAt])
}

/// Item 18 do roadmap — heurística de encomenda sem stock. NÃO cancela nada;
/// só sinaliza para o Carlos rever manualmente. Baseado no stock indexado
/// localmente (CatalogProduct.stock), que pode estar desactualizado até ao
/// próximo ciclo do relógio (45 min) — não é confirmação real do fornecedor.
model OrderStockAlert {
  id            String   @id @default(cuid())
  shop          String
  orderId       String
  orderName     String
  sku           String
  orderedQty    Int
  indexedStock  Int
  createdAt     DateTime @default(now())
  resolved      Boolean  @default(false)

  @@index([shop, resolved])
  @@index([shop, orderId])
}

/// Erros de sincronização Shopify (dashboard — Logs de Erro).
model SyncErrorLog {
  id        String   @id @default(cuid())
  shop      String
  sku       String
  errorType String
  message   String
  jobId     String?
  createdAt DateTime @default(now())
  /// false depois de resolvido (publish com sucesso) ou invalidado numa reindexação
  /// completa. Histórico fica na tabela para a página "Logs de Erro"; contagens de
  /// "erros ativos" (ex.: getPollStats) filtram por active:true.
  active    Boolean  @default(true)

  @@index([shop, createdAt])
  @@index([shop, sku])
  @@index([shop, active])
}

/// Vendas últimos 30 dias (Radar de Curadoria).
model ProductSalesSnapshot {
  shop         String
  sku          String
  unitsSold30d Int      @default(0)
  updatedAt    DateTime @default(now())

  @@id([shop, sku])
  @@index([shop, unitsSold30d])
}

/// Configuração dinâmica por mercado/loja (motor multitenant).
model MarketSettings {
  shop          String   @id
  vipBrands     String   @default("[]")
  vipLicences   String   @default("[]")
  vipCategories String   @default("[]")
  blockedTerms  String   @default("[]")
  updatedAt     DateTime @updatedAt
}

/// Conjuntos de filtros da Curadoria guardados pelo utilizador (segmentos nomeados).
model SavedFilterSet {
  id          String   @id @default(cuid())
  shop        String
  name        String
  /// JSON: { search, searchScope, licenceIds, productTypeIds, brand, minPrice, maxPrice, inStockOnly, curationStatus, reason }
  filtersJson String
  createdAt   DateTime @default(now())

  @@index([shop])
}

/// Ciclo de vida do SKU no feed do fornecedor — persiste ENTRE reindexações completas,
/// ao contrário de CatalogProduct (que é limpo e reconstruído em cada ciclo do relógio,
/// ver syncCatalogWithProgress clearFirst). É a única forma de comparar "SKUs deste
/// ciclo" com "SKUs do ciclo anterior" sem guardar snapshots inteiros do CSV.
/// Usado por lib/importer/catalog/skuLifecycle.server.js para:
///  - Item 2 (novidades): sku com firstSeenAt == ranAt do ciclo atual.
///  - Item 3 (descontinuados): missingCycles incrementa quando o sku não aparece num
///    ciclo; a partir de DISCONTINUED_THRESHOLD (3) o status passa a "review".
model CatalogSkuTracking {
  shop          String
  sku           String
  vendor        String?
  /// JSON string[] — franchises do último ciclo em que o SKU foi visto (para destacar
  /// novidades de licenças VIP sem reconsultar CatalogProduct, que já pode ter mudado).
  franchises    String   @default("[]")
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  missingCycles Int      @default(0)
  /// "active" | "review" (3+ ciclos consecutivos sem aparecer) | "discontinued" (confirmado
  /// manualmente — reservado para quando a despublicação automática for ativada, ver TODO)
  status        String   @default("active")

  @@id([shop, sku])
  @@index([shop, status])
  @@index([shop, lastSeenAt])
}

/// Item 5 do pacote de melhorias criativas de 2026-08-12 — evita recriar/reavaliar a
/// mesma smart collection por licença em todos os ciclos. Uma linha por licença que já
/// atingiu o limiar (10+ publicados) alguma vez, mesmo que a contagem desça depois.
model AutoCollectionLicence {
  shop                String
  /// Licença normalizada (lowercase, trim) — chave de agrupamento, não o label mostrado.
  licenceKey          String
  licenceLabel        String
  shopifyCollectionId String
  productCountAtCreate Int     @default(0)
  createdAt           DateTime @default(now())

  @@id([shop, licenceKey])
}

/// Token de download único para a fatura de uma encomenda, emitido depois de validar
/// (via session token do Customer Account UI Extension) que o cliente autenticado é o
/// dono da encomenda. O snapshot da encomenda (JSON) é buscado UMA vez, no momento do
/// pedido, e guardado aqui — o resgate do token (rota pública) nunca volta a chamar a
/// Admin API, por isso nunca pode falhar a meio depois de o token já ter sido gasto.
model InvoiceDownloadToken {
  token             String    @id @default(cuid())
  shop              String
  orderId           String
  customerId        String
  orderSnapshotJson String
  expiresAt         DateTime
  usedAt            DateTime?
  createdAt         DateTime  @default(now())

  @@index([shop, orderId])
}

/// Um registo por ciclo completo de indexação (não resumido) — alimenta o banner de
/// novidades na Curadoria e a secção de descontinuados em Relatórios. Histórico mantido
/// para tendência; a UI normalmente só lê o mais recente por shop.
model SkuLifecycleCycleReport {
  id                    String   @id @default(cuid())
  shop                  String
  ranAt                 DateTime @default(now())
  newSkuCount           Int      @default(0)
  /// JSON [{ sku, vendor, franchises }] — só as novidades de marcas/licenças VIP
  newVipSkusJson        String   @default("[]")
  discontinuedReviewCount Int    @default(0)
  /// JSON [{ sku, vendor, missingCycles }]
  discontinuedReviewJson String @default("[]")

  @@index([shop, ranAt])
}
